---
import { getEntry } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import DienstKop from '../components/DienstKop.astro';
import DienstBeeld from '../components/DienstBeeld.astro';
import ZorgBeeld from '../components/home/ZorgBeeld.astro';
import { dienstNode, dienstId, faqNode } from '../lib/schema';
import CtaBlok from '../components/CtaBlok.astro';
import { site } from '../site';

// Prijzen en duur komen rechtstreeks uit de diensten-content, zodat deze pagina
// nooit uit de pas loopt met wat elders op de site staat.
const scan = await getEntry('diensten', 'readiness-scan');
const rollout = await getEntry('diensten', 'rollout');
const retainer = await getEntry('diensten', 'retainer');
if (!scan || !rollout || !retainer) throw new Error('Diensten-content ontbreekt');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Claude implementatie', url: '/claude-implementatie' },
];

const stappen = [
  {
    naam: 'Gratis AI-check',
    duur: '2 minuten, online',
    tekst: 'Zeven vragen over je bedrijf en je processen. Je krijgt direct een score en ziet of een Claude-implementatie op dit moment zin heeft. Zo niet, dan weet je dat ook: scheelt ons allebei tijd.',
    link: '/ai-enablement-scan',
    linkTekst: 'Doe de gratis AI-check',
  },
  {
    naam: scan.data.titel,
    duur: scan.data.duur,
    tekst: 'Een dag op locatie, een week waarin we je processen en tools uitdiepen. Je krijgt een Nederlands rapport met vijf tot tien use cases gerangschikt op ROI, een frictiekaart van je huidige stack en een vaste offerte voor de rollout. Je weet dus wat de implementatie kost voordat je beslist.',
    link: '/claude-readiness-scan',
    linkTekst: 'Bekijk de Readiness Scan',
  },
  {
    naam: rollout.data.titel,
    duur: rollout.data.duur,
    tekst: 'De eigenlijke implementatie. Kickoff-workshop voor iedereen, twee tot vier collega’s worden getraind als champions, een promptbibliotheek op maat van jouw use cases, drie verdiepende workshops en hulp bij het opzetten van de seats voor Claude Team of Enterprise. Afsluiting met een adoptie-readout tegen de nulmeting.',
    link: '/claude-in-30-dagen',
    linkTekst: 'Bekijk Claude in 30 dagen',
  },
  {
    naam: `${retainer.data.titel} (optioneel)`,
    duur: retainer.data.duur,
    tekst: 'Voor wie na de rollout wil doorpakken: elke maand een workshop en twee uur bereikbaarheid via Slack of Teams, plus uitbreiding van de promptbibliotheek en een kwartaalreview met het management.',
    link: '/claude-compagnon',
    linkTekst: 'Bekijk de Claude Compagnon',
  },
];

const prijzen = [
  { naam: scan.data.titel, prijs: scan.data.prijs, duur: scan.data.duur, link: '/claude-readiness-scan' },
  { naam: rollout.data.titel, prijs: rollout.data.prijs, duur: rollout.data.duur, link: '/claude-in-30-dagen' },
  { naam: retainer.data.titel, prijs: retainer.data.prijs, duur: retainer.data.duur, link: '/claude-compagnon' },
];

const voorbeelden = [
  {
    cijfer: '2 min',
    kop: 'Rapportages op aanvraag bij een MSP-softwarebedrijf',
    tekst: 'Klanten vroegen kwartaalrapportages aan en een medewerker was daar per rapport 30 tot 45 minuten mee bezig. Nu vragen klanten het zelf op in een chat en staat het rapport er binnen twee minuten, met validatie tegen het echte datamodel.',
    slug: 'copilot-studio-agent',
  },
  {
    kop: 'Kennisbank in vijf dagen bij een IT-dienstverlener',
    cijfer: '13 artikelen',
    tekst: 'Het supportteam typte dezelfde instructies steeds opnieuw, want een kennisbank bouwen kostte een werkweek per dertig vragen. In vijf dagen stonden er 13 artikelen met 27 screenshots live. Besparing: ruim zes uur per week.',
    slug: 'knowledge-base',
  },
  {
    kop: '872 Power BI-reports in drie maanden',
    cijfer: '872 reports',
    tekst: 'Anderhalf uur handwerk per rapport, keer 50 klanten, keer twee talen. Nu genereert een slash command complete reports met gevalideerde DAX-queries. Het team besteedt er nu minder dan een uur per week aan.',
    slug: 'powerbi-reporting',
  },
];

const faqItems = [
  {
    question: 'Wat kost een Claude-implementatie?',
    answer: `De Readiness Scan kost ${scan.data.prijs.toLowerCase()}, de rollout (Claude in 30 dagen) ${rollout.data.prijs.toLowerCase()}. Een complete implementatie begint dus bij €9.000. Een custom MCP-server voor je eigen stack kost €2.000 tot €5.000 extra, maar alleen als de scan aantoont dat dat zin heeft. Na de scan krijg je een vaste offerte, dus je weet precies wat de rollout kost voordat je beslist.`,
  },
  {
    question: 'Hoe lang duurt een Claude-implementatie?',
    answer: 'De Readiness Scan duurt een dag op locatie plus een week uitwerken. De rollout duurt vier weken, met ongeveer twee dagen per week begeleiding. Van eerste kennismaking tot een team dat zelfstandig met Claude werkt zit je dus op zes tot acht weken.',
    linkHref: '/claude-in-30-dagen',
    linkTekst: 'Lees hoe de vier weken eruitzien',
  },
  {
    question: 'Kan een Claude-implementatie aan de AVG voldoen?',
    answer: 'Ja, mits je het goed inricht. We zetten Claude op via de zakelijke voorwaarden van Anthropic: geen training op jouw data en een verwerkersovereenkomst (DPA). Daarnaast maken we per implementatie afspraken over welke data wel en niet in Claude gaat, en richten we SSO in. Op onze compliance-pagina leggen we de details uit in gewoon Nederlands.',
    linkHref: '/compliance',
    linkTekst: 'Naar het compliance-overzicht',
  },
  {
    question: 'Moeten we zelf technische kennis in huis hebben?',
    answer: 'Nee. Alles wordt uitgelegd in het Nederlands, zonder jargon, en we werken met jouw echte documenten en processen. Twee tot vier mensen uit je eigen team worden tijdens de rollout getraind als champions; zij dragen de kennis verder nadat wij weg zijn.',
  },
  {
    question: 'Welke Claude-licenties hebben we nodig en wat kosten die?',
    answer: 'De licenties (meestal Claude Team) neem je rechtstreeks af bij Anthropic; wij helpen bij het opzetten van de seats tijdens de rollout. Op onze prijzen-pagina houden we een actueel overzicht bij van de abonnementen en kosten.',
    linkHref: '/prijs',
    linkTekst: 'Bekijk het prijzenoverzicht',
  },
  {
    question: 'Verliezen mensen hun baan door de implementatie?',
    answer: 'Nee. Het doel is dat je huidige team meer werk verzet, niet dat het kleiner wordt. De champions worden de interne kennisdragers, niet de vervangers van collega’s. Zoek je een implementatie om te bezuinigen op mensen, dan zijn wij niet de juiste partij.',
  },
];

const schemaFaq = faqItems.map(({ question, answer }) => ({ question, answer }));
---
<BasisLayout
  titel="Claude implementatie: kosten en doorlooptijd"
  beschrijving="Wat een Claude-implementatie inhoudt en kost: scan vanaf €1.500, rollout in 30 dagen vanaf €7.500. Vaste prijzen, praktijkvoorbeelden, AVG-afspraken."
  pad="/claude-implementatie"
  schema={{
    breadcrumbs,
    hoofdonderwerp: dienstId('/claude-implementatie'),
    nodes: [
      dienstNode({
        pad: '/claude-implementatie',
        naam: 'Claude implementatie',
        beschrijving: 'Claude-implementatie voor het Nederlandse MKB: van Readiness Scan tot rollout in 30 dagen, met vaste prijzen.',
        serviceType: 'Claude-implementatie',
        catalogus: prijzen.map((r) => ({ naam: r.naam, prijsTekst: r.prijs, url: r.link, dienstPad: r.link })),
      }),
      faqNode('/claude-implementatie', schemaFaq),
    ],
  }}
>

  <article class="v2-artikel">
    <DienstKop breadcrumbs={breadcrumbs} label="Dienst" h1="Claude-implementatie voor het Nederlandse MKB">
      <p>
        Een losse Claude-licentie kopen is vijf minuten werk. Zorgen dat je team er
        dagelijks echt werk mee verzet, is een ander verhaal. Dat verschil heet een
        implementatie: use cases kiezen die geld opleveren, de omgeving veilig
        inrichten, mensen trainen en volhouden tot het gewoonte is.
      </p>
      <p>
        Wij doen die implementatie voor Nederlandse MKB-bedrijven van tien tot
        tweehonderd mensen. Je hoeft er niks van AI voor te weten; alles wordt
        uitgelegd in gewoon Nederlands. Wie het werk doet, lees je op de pagina
        over onze <a href="/claude-consultant">Claude-consultant</a>.
        Ben je nog aan het oriënteren? Lees dan eerst de gids <a href="/gids/claude-voor-mkb">Claude voor bedrijven en mkb</a>.
      </p>
      <DienstBeeld slot="beeld" soort="route" />
    </DienstKop>

    <section class="v2-sectie v2-stappen">
      <div class="v2-stappen-intro">
        <h2>Zo pakken we een Claude-implementatie aan</h2>
        <p class="v2-sectie-intro">
          Vier stappen, elk los af te nemen. Je gaat pas door als de vorige stap z&rsquo;n
          geld waard was.
        </p>
        <p class="v2-sectie-noot">Hoe we elke stap uitvoeren, staat in <a href="/methodologie">onze methode in vijf bouwstenen</a>.</p>
      </div>
      <ol class="v2-kaarten list-none m-0 p-0">
        {stappen.map((stap, i) => (
          <li class:list={['v2-kaart', i === 2 && 'v2-kaart-donker']}>
            <div class="v2-kaart-tekst">
              <p class="v2-kaart-stap">Stap {i + 1}</p>
              <h3>{stap.naam}</h3>
              <p class="v2-kaart-prijs">{stap.duur}</p>
              <p class="m-0">{stap.tekst}</p>
              <a href={stap.link} class="v2-kaart-link">{stap.linkTekst} &rarr;</a>
            </div>
            <p class="v2-kaart-nummer" aria-hidden="true">{`0${i + 1}`}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="prijzen" class="v2-sectie">
      <h2>Wat kost een Claude-implementatie?</h2>
      <p class="v2-sectie-intro">
        Onze prijzen staan online, zodat je zelf kunt rekenen.
      </p>
      <div class="v2-tabelkaart">
        <table>
          <thead>
            <tr>
              <th>Stap</th>
              <th>Prijs</th>
              <th>Duur</th>
            </tr>
          </thead>
          <tbody>
            {prijzen.map((rij) => (
              <tr>
                <td><a href={rij.link}>{rij.naam}</a></td>
                <td>{rij.prijs}</td>
                <td>{rij.duur}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="v2-sectie-noot">
        Een complete implementatie (scan plus rollout) begint dus bij &euro;9.000.
        Optioneel erbij: een custom MCP-server voor je eigen stack (&euro;2.000 tot
        &euro;5.000) of integratie-coaching per uur, allebei alleen als de scan
        aantoont dat het zin heeft. De Claude-licenties zelf neem je rechtstreeks af
        bij Anthropic. Wat die kosten, staat in <a href="/prijs">Claude kosten zakelijk</a>; welk abonnement je nodig hebt, lees je in <a href="/prijs/pro-vs-team-vs-enterprise">Claude Pro, Team of Enterprise</a>.
      </p>
      <p class="v2-sectie-noot">
        Belangrijkste afspraak: na de Readiness Scan krijg je een vaste offerte voor
        de rollout.
      </p>
      {/* MENS: is er een afgerond traject waarvan we het totaalbedrag mogen noemen? Eén echt voorbeeld ("bedrijf X betaalde in totaal €Y") maakt deze sectie een stuk overtuigender. */}
    </section>

    <section class="v2-sectie">
      <h2>Hoe dat er in de praktijk uitziet</h2>
      <p class="v2-sectie-intro">
        Drie voorbeelden die ons team eerder bouwde bij Nederlandse IT-bedrijven, met de cijfers erbij.
      </p>
      <div class="v2-bewijs">
        {voorbeelden.map((v) => (
          <div>
            <span class="v2-bewijs-cijfer">{v.cijfer}</span>
            <h3>{v.kop}</h3>
            <p>{v.tekst}</p>
            <a href={`/cases/${v.slug}`}>Lees de case &rarr;</a>
          </div>
        ))}
      </div>
      <p class="v2-sectie-noot">
        Meer voorbeelden staan bij de <a href="/cases">cases</a>. Per branche uitgewerkt: <a href="/claude-voor-accountants">Claude voor accountants</a>, <a href="/claude-voor-advocaten">Claude voor advocaten</a>, <a href="/claude-voor-makelaars">Claude voor makelaars</a> en <a href="/claude-voor-marketingbureaus">Claude voor marketingbureaus</a>.
      </p>
      {/* MENS: welk implementatiemoment blijft jou het meest bij (een reactie van een medewerker, een use case die verrassend goed werkte)? Eén zin eigen ervaring hier maakt de pagina persoonlijker. */}
    </section>

    <section class="v2-sectie">
      <div class="v2-avg">
        <div>
          <h2>Privacy en AVG-afspraken vanaf dag één</h2>
          <p>
            Elke implementatie begint met de saaie maar belangrijke kant: zakelijke
            voorwaarden bij Anthropic (geen training op jouw data, <a href="/compliance/anthropic-dpa">verwerkersovereenkomst</a>
            getekend), SSO, en heldere afspraken over welke data wel en niet in Claude
            gaat. We zetten Claude eerst op in een afgeschermde testomgeving met review-stappen. Wijzigingen aan je systemen gaan pas live als jij akkoord geeft. Hoe dat juridisch zit, leggen we
            uit op <a href="/compliance">Claude en de AVG: wat regel je als bedrijf?</a>. Moet je data in de EU blijven, lees dan <a href="/compliance/eu-hosting">Claude-data in de EU houden</a>. Wat de AI Act van je vraagt, staat in <a href="/compliance/ai-act-mkb">Claude en de EU AI Act voor het MKB</a>.
          </p>
        </div>
        <ZorgBeeld nr={1} />
      </div>
    </section>

    <section class="v2-sectie v2-dienst-faq">
      <h2>Veelgestelde vragen over Claude-implementatie</h2>
      <div class="v2-faq-lijst">
        {faqItems.map(item => (
          <details class="v2-faq-item">
            <summary class="v2-faq-vraag">
              {item.question}
              <span class="v2-faq-plus" aria-hidden="true">+</span>
            </summary>
            <div class="v2-faq-antwoord">
              {item.answer}
              {item.linkHref && (
                <a href={item.linkHref}>{item.linkTekst} &rarr;</a>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  </article>

  <CtaBlok
    kop="Benieuwd of een Claude-implementatie past?"
    tekst="Doe de gratis AI-check. Twee minuten werk, je krijgt direct een score. Past het, dan plannen we een gratis intro-gesprek en begint het traject met de Readiness Scan."
    link="/ai-enablement-scan"
    linkTekst="Doe de gratis AI-check"
  />
</BasisLayout>
