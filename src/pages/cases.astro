---
import { itemListNode, lijstId } from '../lib/schema';
import { getCollection } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import CtaWarm from '../components/CtaWarm.astro';
import CaseKaart from '../components/CaseKaart.astro';
import Broodkruimel from '../components/Broodkruimel.astro';

const allCases = await getCollection('cases');

const sectorVolgorde = ['SaaS', 'MSP', 'IT-consultancy', 'IT-dienstverlener'];

const perSector = sectorVolgorde
  .map((sector) => ({
    sector,
    cases: allCases
      .filter((c) => c.data.sector === sector)
      .sort((a, b) => a.data.title.localeCompare(b.data.title, 'nl')),
  }))
  .filter((g) => g.cases.length > 0);
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Cases', url: '/cases' }];
---
<BasisLayout
  titel={`Claude praktijkvoorbeelden: ${allCases.length} projecten`}
  beschrijving={`${allCases.length} projecten die we met Claude Code bouwden, van een CRM en Power BI-rapportages tot een sales-agent. Per case het probleem, de aanpak en het resultaat.`}
  pad="/cases"
  schema={{ paginaType: 'CollectionPage', hoofdonderwerp: lijstId('/cases'), breadcrumbs, nodes: [itemListNode('/cases', perSector.flatMap((g) => g.cases).map((c) => ({ url: `/cases/${c.id}`, naam: c.data.title })))] }}
>
  <header class="v2-artikel-kop">
    <div class="v2-artikel-kop-binnen">
      <Broodkruimel items={breadcrumbs} />
      <p class="v2-chip">Praktijkvoorbeelden</p>
      <h1 class="v2-artikel-h1">Wat we met Claude gebouwd hebben</h1>
      <p class="v2-hub-lead">
        Geen hypothetische scenario's. Dit zijn echte projecten, met echte resultaten. Elke case beschrijft het probleem, de aanpak en wat het opleverde.
      </p>
      <p class="v2-hub-noot">Wil je eerst weten wat Claude voor een bedrijf kan? Lees de gids <a href="/gids/claude-voor-mkb">Zakelijk Claude-account en abonnement voor het mkb</a>. Wie deze projecten bouwde, lees je bij <a href="/over">over ons</a>.</p>
    </div>
  </header>

  <div class="v2-sectie v2-hub" data-filter>
    {/* Filter: alleen met JS zichtbaar; zonder JS staan gewoon alle sectoren onder elkaar. */}
    <div class="v2-filter" role="group" aria-label="Filter op sector" hidden>
      <button type="button" aria-pressed="true" data-sector="">Alle <span>{allCases.length}</span></button>
      {perSector.map(({ sector, cases }) => (
        <button type="button" aria-pressed="false" data-sector={sector}>{sector} <span>{cases.length}</span></button>
      ))}
    </div>

    {perSector.map(({ sector, cases }) => (
      <section class="v2-hub-groep" data-groep={sector}>
        <h2>{sector}</h2>
        <div class="v2-case-raster-kaarten">
          {cases.map((c) => (
            <CaseKaart
              title={c.data.title}
              description={c.data.description}
              sector={c.data.sector}
              duration={c.data.duration}
              tools={c.data.tools}
              results={c.data.results}
              kernwinst={c.data.kernwinst}
              slug={c.id}
            />
          ))}
        </div>
      </section>
    ))}
  </div>

  <div class="v2-sectie v2-hub-slot">
    <CtaWarm titel="Herken je een van deze uitdagingen?" secundairLabel="Vraag een intro-gesprek aan" secundairHref="/contact" />
  </div>

  <script>
    const hub = document.querySelector<HTMLElement>('[data-filter]');
    const balk = hub?.querySelector<HTMLElement>('.v2-filter');
    if (hub && balk) {
      balk.hidden = false;
      const knoppen = Array.from(balk.querySelectorAll<HTMLButtonElement>('button'));
      const groepen = Array.from(hub.querySelectorAll<HTMLElement>('[data-groep]'));
      knoppen.forEach((knop) => knop.addEventListener('click', () => {
        const sector = knop.dataset.sector;
        knoppen.forEach((k) => k.setAttribute('aria-pressed', String(k === knop)));
        groepen.forEach((g) => { g.hidden = Boolean(sector) && g.dataset.groep !== sector; });
      }));
    }
  </script>
</BasisLayout>
