---
import BasisLayout from '../../layouts/BasisLayout.astro';
import Broodkruimel from '../../components/Broodkruimel.astro';
import KortAntwoord from '../../components/KortAntwoord.astro';
import FaqSectie from '../../components/FaqSectie.astro';
import BronnenBlok from '../../components/BronnenBlok.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import CtaStrook from '../../components/CtaStrook.astro';
import ArtikelInhoud from '../../components/ArtikelInhoud.astro';
import { faqNode } from '../../lib/schema';

const titel = 'Claude voor bedrijven en mkb';
const titleTag = 'Claude voor bedrijven en mkb: de gids | Implementeren.ai';
const beschrijving =
  'Claude voor bedrijven en mkb: welk abonnement past, wat het kost, wat je team ermee doet, hoe het zit met de AVG en hoe je de invoering aanpakt.';
const pad = '/gids/claude-voor-mkb';

const gepubliceerd = new Date('2026-10-02');
const bijgewerkt = new Date('2026-10-02');
const datumNl = (d: Date) => d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const datumIso = (d: Date) => d.toISOString().slice(0, 10);

const kortAntwoord =
  'Claude is de AI-assistent van Anthropic. Voor een bedrijf met 5 tot 150 mensen is Claude Team meestal de beste keuze: 25 dollar per gebruiker per maand (20 dollar bij jaarbetaling, stand 2 oktober 2026), met centraal beheer en SSO. Anthropic traint niet op zakelijke data. Begin met één of twee concrete taken en een paar heldere afspraken over data.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gidsen', url: '/gids' },
  { name: titel, url: pad },
];

const faq = [
  {
    question: 'Wat kost Claude voor een bedrijf met tien medewerkers?',
    answer:
      'Met Claude Team en standaard seats betaal je 25 dollar per gebruiker per maand, of 20 dollar bij jaarbetaling. Voor tien mensen is dat 250 dollar per maand, of 200 dollar per maand bij een jaarcontract. Dat is exclusief btw. Een implementatie met begeleiding komt daar los bij.',
  },
  {
    question: 'Mag ik Claude Pro gebruiken voor mijn werk?',
    answer:
      'Dat kan, maar Pro valt onder de consumentenvoorwaarden van Anthropic. Daarin kies je zelf of je gesprekken gebruikt mogen worden om Claude te verbeteren. Er is geen centraal beheer en geen verwerkersovereenkomst voor je bedrijf. Werk je met klant- of personeelsgegevens, kies dan Team of Enterprise.',
  },
  {
    question: 'Traint Anthropic Claude op onze bedrijfsgegevens?',
    answer:
      'Niet bij zakelijke diensten. De commerciële voorwaarden van Anthropic zeggen dat Anthropic geen modellen mag trainen op de content van klanten. Dat geldt voor Claude Team, Enterprise en de API. De verwerkersovereenkomst (DPA) is onderdeel van die voorwaarden.',
  },
  {
    question: 'Blijven onze gegevens in de EU?',
    answer:
      'Dat is niet gegarandeerd. Bij de API van Anthropic kun je op dit moment alleen kiezen tussen wereldwijd en de VS, en voor Claude Team en Enterprise vonden we geen EU-toezegging. Wie verwerking in de EU wil afdwingen, gebruikt Claude via Amazon Bedrock of Google Cloud Vertex AI met een Europese regio.',
  },
  {
    question: 'Hoe lang duurt het om Claude in te voeren?',
    answer:
      'Bij ons duurt een volledig traject zes tot acht weken. Eerst een Readiness Scan van een dag op locatie plus een week uitwerken. Daarna een rollout van vier weken met ongeveer twee dagen per week begeleiding. Daarna werkt je team zelfstandig.',
  },
];

const bronnen = [
  { titel: 'Anthropic, prijspagina Claude (claude.com/pricing)', url: 'https://claude.com/pricing', geraadpleegd: '2 oktober 2026' },
  { titel: 'Anthropic, Commercial Terms of Service (ingangsdatum 17 juni 2025)', url: 'https://www.anthropic.com/legal/commercial-terms', geraadpleegd: '2 oktober 2026' },
  { titel: 'Anthropic, Updates to Consumer Terms and Privacy Policy (28 augustus 2025)', url: 'https://www.anthropic.com/news/updates-to-our-consumer-terms', geraadpleegd: '2 oktober 2026' },
  { titel: 'Anthropic, documentatie Data residency (inference geo en workspace geo)', url: 'https://platform.claude.com/docs/en/manage-claude/data-residency', geraadpleegd: '2 oktober 2026' },
  { titel: 'Anthropic, Regional compliance (Claude via Bedrock, Vertex AI en Foundry)', url: 'https://claude.com/regional-compliance', geraadpleegd: '2 oktober 2026' },
];

// Inhoudsopgave: de h2's van deze gids (ids staan op de koppen hieronder).
const koppen = [
  {
    depth: 2,
    slug: "wat-is-claude-voor-een-bedrijf",
    text: "Wat is Claude voor een bedrijf?"
  },
  {
    depth: 2,
    slug: "welk-abonnement-past-bij-mijn-bedrijf",
    text: "Welk abonnement past bij mijn bedrijf?"
  },
  {
    depth: 2,
    slug: "wat-kost-claude-voor-een-team-van-tien-mensen",
    text: "Wat kost Claude voor een team van tien mensen?"
  },
  {
    depth: 2,
    slug: "wat-doet-een-team-in-de-praktijk-met-claude",
    text: "Wat doet een team in de praktijk met Claude?"
  },
  {
    depth: 2,
    slug: "is-claude-veilig-en-past-het-bij-de-avg",
    text: "Is Claude veilig en past het bij de AVG?"
  },
  {
    depth: 2,
    slug: "hoe-verloopt-een-implementatie",
    text: "Hoe verloopt een implementatie?"
  },
  {
    depth: 2,
    slug: "welke-fouten-zien-we-vaak",
    text: "Welke fouten zien we vaak?"
  },
  {
    depth: 2,
    slug: "claude-of-een-andere-ai-assistent",
    text: "Claude of een andere AI-assistent?"
  },
  {
    depth: 2,
    slug: "waar-begin-ik",
    text: "Waar begin ik?"
