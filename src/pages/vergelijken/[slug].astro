---
import { render } from 'astro:content';
import VergelijkingLayout from '../../layouts/VergelijkingLayout.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
  const pages = await getPublished('vergelijkingen');
  return pages.map(page => ({
    params: { slug: page.id },
    props: { entry: page },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<VergelijkingLayout entry={entry} pagePath={`/vergelijken/${entry.id}`}>
  <Content />
</VergelijkingLayout>
