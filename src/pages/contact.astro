---
import BasisLayout from '../layouts/BasisLayout.astro';
import { site } from '../site';
import { ID } from '../lib/schema';
import Broodkruimel from '../components/Broodkruimel.astro';
import { Picture } from 'astro:assets';
import camielWater from '../assets/team/camiel-water.jpg';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }];
---
<BasisLayout
  titel="Contact"
  beschrijving="Vraag een intro van 30 minuten aan of stuur een mailtje. Geen salesverhaal, gewoon even sparren of het past."
  pad="/contact"
  schema={{ paginaType: 'ContactPage', hoofdonderwerp: ID.organisatie, breadcrumbs, overClaude: false }}
>
  <section class="v2-contact">
    <div class="v2-contact-tekst">
      <Broodkruimel items={breadcrumbs} />
      <p class="v2-chip">Contact</p>
      <h1 class="v2-artikel-h1">Even kennismaken?</h1>
      <p class="v2-check-lead">
        Begin met de gratis AI-check. Past het? Dan krijg je daarna direct een gratis intro-gesprek aangeboden. Zo weet je zeker dat een gesprek zin heeft voor jou.
      </p>
    </div>

    <div class="v2-contact-kaart">
      <p class="v2-contact-kaart-kop">Start met de gratis AI-check</p>
      <p>Twee minuten invullen. Je krijgt direct je AI-check-score en een concreet advies.</p>
      <a href="/ai-enablement-scan" class="v2-knop v2-knop-donker">Doe de AI-check</a>
    </div>

    <div class="v2-contact-mail">
      <p class="v2-contact-mail-kop">Liever eerst mailen?</p>
      <p>
        Stuur een mailtje naar <a href={`mailto:${site.email}`}>{site.email}</a>. Je hoort binnen een werkdag terug.
        Wat we met je gegevens doen, staat in onze <a href="/privacy">privacyverklaring</a>.
      </p>
    </div>

    <div class="v2-contact-gebied">
      <p>Werkgebied: Nederland. Werktaal: Nederlands (Engels op verzoek).</p>
    </div>
  </section>

  <!-- 2e: contactblok met foto -->
  <section class="v2-sectie v2-contact-foto reveal-target">
    <div class="v2-persoon">
      <Picture
        src={camielWater}
        alt="Camiel Wits, lachend in gesprek aan het water"
        formats={['avif', 'webp']}
        widths={[480, 640, 828, 1080, 1280]}
        sizes="(min-width: 1152px) 460px, (min-width: 768px) 40vw, calc(100vw - 48px)"
        class="foto-warm"
        style="object-position: 58% 22%;"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="v2-label">Contact</p>
        <h2>Vraag een kennismaking aan</h2>
        <p>Een half uur, online of op locatie. Je spreekt direct met een van de mensen die het werk doet, geen salesteam ertussen.</p>
        <ul class="v2-resultaten">
          <li><span class="v2-vink" aria-hidden="true">&#10003;</span> Binnen één werkdag antwoord</li>
          <li><span class="v2-vink" aria-hidden="true">&#10003;</span> Een eerlijk advies, ook als het antwoord 'nog niet' is</li>
        </ul>
        <a href={`mailto:${site.email}`} class="v2-knop v2-knop-olijf mt-6">
          Neem contact op<span class="cta-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BasisLayout>
