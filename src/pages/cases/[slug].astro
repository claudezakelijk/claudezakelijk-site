---
import { getCollection, render } from 'astro:content';
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BasisLayout from '../../layouts/BasisLayout.astro';
import CtaWarm from '../../components/CtaWarm.astro';
import Broodkruimel from '../../components/Broodkruimel.astro';
import ArtikelInhoud from '../../components/ArtikelInhoud.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({
    params: { slug: c.id },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Cases', url: '/cases' },
  { name: entry.data.title, url: `/cases/${entry.id}` },
];
// Drie volgende cases in dezelfde volgorde als /cases (sector, dan titel), rondlopend:
// elke case krijgt zo precies drie inkomende links van andere cases.
const sectorVolgorde = ['SaaS', 'MSP', 'IT-consultancy', 'IT-dienstverlener'];
const gesorteerd = (await getCollection('cases')).sort(
  (a, b) =>
    sectorVolgorde.indexOf(a.data.sector) - sectorVolgorde.indexOf(b.data.sector) ||
    a.data.title.localeCompare(b.data.title, 'nl'),
);
const positie = gesorteerd.findIndex((c) => c.id === entry.id);
const meerCases = [1, 2, 3].map((k) => gesorteerd[(positie + k) % gesorteerd.length]);

const diagramPath = resolve('src/assets/diagrams', `${entry.id}.svg`);
const diagramSvg = existsSync(diagramPath) ? readFileSync(diagramPath, 'utf-8') : null;

// Kernwinst met een pijl (bv. "180 euro/maand → 0 euro") splitsen zodat het
// "vóór → na" visueel oploopt; zonder pijl valt het terug op één blok.
const kw = entry.data.kernwinst;
const kwParts = kw && kw.includes('→') ? kw.split('→').map((s) => s.trim()) : null;
const heeftResultaatBlok = entry.data.kernwinst || entry.data.klantprofiel || entry.data.results.length > 0;

// Datum + schema (review Max 23 juli, B5/B9): zichtbare publicatiedatum, Article-node
// en BreadcrumbList via de schema/artikel-props van BasisLayout (src/lib/schema.ts),
// zodat de pagina precies één JSON-LD-blok heeft met de sitebrede entiteiten erin.
// Een case heeft geen zichtbare byline, dus het schema noemt de organisatie als auteur.
const datumNl = entry.data.publishDate.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const artikel = {
  headline: entry.data.title,
  gepubliceerd: entry.data.publishDate,
  bijgewerkt: null,
  auteur: 'organisatie',
  sectie: 'Cases',
} as const;
---
<BasisLayout
  titel={entry.data.titleTag ?? entry.data.title}
  beschrijving={entry.data.metaDescription ?? entry.data.description}
  pad={`/cases/${entry.id}`}
  schema={{ breadcrumbs }}
  artikel={artikel}
>
  <article class="v2-artikel">
    <div class="v2-voortgang" aria-hidden="true"></div>

    <!-- 1 · Broodkruimel + meta + 2 · H1 + 3 · intro, met rechts het resultaat -->
    <header class="v2-dienst-kop">
      <div class="v2-dienst-kop-binnen v2-case-kop">
        <div class="v2-dienst-kop-tekst">
          <Broodkruimel items={breadcrumbs} />
          {!heeftResultaatBlok && (
            <div class="v2-chips">
              <span class="v2-chip">{entry.data.sector}</span>
              <span class="v2-chip v2-chip-zacht">{entry.data.duration}</span>
            </div>
          )}
          <h1 class="v2-artikel-h1">{entry.data.title}</h1>
          <p>{entry.data.description}</p>
          <p class="v2-case-datum">Gepubliceerd op <time datetime={entry.data.publishDate.toISOString().slice(0, 10)}>{datumNl}</time></p>
        </div>

        <!-- 4 · In één oogopslag: meta-strip + kernwinst + resultaten -->
        {heeftResultaatBlok && (
          <section class="v2-resultaat">
            <dl class:list={['v2-resultaat-meta', entry.data.klantprofiel && 'v2-met-context']}>
              {entry.data.klantprofiel && (
                <div class="v2-resultaat-context">
                  <dt>Context</dt>
                  <dd>{entry.data.klantprofiel}</dd>
                </div>
              )}
              <div>
                <dt>Doorlooptijd</dt>
                <dd>{entry.data.duration}</dd>
              </div>
              <div>
                <dt>Sector</dt>
                <dd>{entry.data.sector}</dd>
              </div>
            </dl>
            {entry.data.kernwinst && (
              <div class="v2-kernwinst">
                {kwParts ? (
                  <>
                    <span class="v2-kernwinst-voor">{kwParts[0]}</span>
                    <span class="v2-kernwinst-pijl">&rarr;</span>
                    <span class="v2-kernwinst-na">{kwParts[1]}</span>
                  </>
                ) : (
                  <span class="v2-kernwinst-na">{entry.data.kernwinst}</span>
                )}
              </div>
            )}
            {entry.data.results.length > 0 && (
              <ul class="v2-resultaten">
                {entry.data.results.map((r) => (
                  <li><span class="v2-vink" aria-hidden="true">&#10003;</span><span>{r}</span></li>
                ))}
              </ul>
            )}
          </section>
        )}
      </div>
    </header>

    {(entry.data.voorJou || entry.data.tools.length > 0) && (
      <div class="v2-sectie v2-case-strook">
        {entry.data.voorJou && (
          <div class="v2-voorjou">
            <h2>Wat betekent dit voor jouw bedrijf?</h2>
            <p>{entry.data.voorJou}</p>
            <a href="/ai-enablement-scan">Doe de gratis AI-check <span aria-hidden="true">&rarr;</span></a>
          </div>
        )}
        <!-- 5 · Tool-chips -->
        {entry.data.tools.length > 0 && (
          <div class="v2-tools">
            <p>Gebruikte tools</p>
            <div>
              {entry.data.tools.map((tool) => (<span>{tool}</span>))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- 6 · Technisch diagram (alleen als er een schets bestaat) -->
    {diagramSvg && (
      <figure class="v2-sectie v2-diagram">
        <div set:html={diagramSvg} />
      </figure>
    )}

    <!-- 7 · Verhalende body, met inhoudsopgave rechts -->
    <div class="v2-artikel-raster v2-case-raster">
      <ArtikelInhoud soort="zijkant" koppen={headings} />
      <div class="v2-artikel-tekst">
        <ArtikelInhoud soort="mobiel" koppen={headings} />
        <div class="case-body">
          <Content />
        </div>

        <!-- 7b · Doorverwijzing naar de dienstpagina's (interne links, één plek voor alle cases) -->
        <p class="v2-case-door">
          Wil je iets vergelijkbaars in je eigen bedrijf? Lees hoe een <a href="/claude-implementatie">Claude-implementatie</a> verloopt, of bekijk de rollout <a href="/claude-in-30-dagen">Claude in 30 dagen</a>.
        </p>
      </div>
    </div>
  </article>

  <div class="v2-artikel-na">
    <section class="v2-gerelateerd">
      <h2>Meer cases</h2>
      <ul class="v2-gerelateerd-raster list-none p-0 m-0">
        {meerCases.map((c) => (
          <li><a href={`/cases/${c.id}`}>{c.data.title}</a></li>
        ))}
      </ul>
    </section>

    <!-- 8 · Afsluitende CTA -->
    <div class="mt-16">
      <CtaWarm titel="Herken je deze uitdaging?" secundairLabel="Alle cases" secundairHref="/cases" />
    </div>
  </div>
</BasisLayout>

<style>
  /* Body van de case: schreefloze v2-koppen, rustige ritmiek. */
  .case-body :global(h2) {
    font-family: var(--font-v2-kop);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.4vw + 1rem, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 56px 0 16px;
  }
  .case-body :global(h2:first-child) { margin-top: 0; }
  .case-body :global(h3) {
    font-family: var(--font-v2-kop);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 21px;
    line-height: 1.3;
    margin: 32px 0 12px;
  }
  .case-body { margin-top: 8px; font-size: 18px; line-height: 1.75; }
  .case-body :global(h2) { scroll-margin-top: 96px; }
  .case-body :global(p) { margin: 0 0 20px; text-wrap: pretty; }
  .case-body :global(ul), .case-body :global(ol) { margin: 0 0 20px; padding-left: 1.25rem; display: grid; gap: 8px; }
  .case-body :global(a) { color: var(--color-v2-olijf); text-decoration: underline; text-decoration-color: rgba(61, 82, 32, .35); text-underline-offset: 3px; }
  .case-body :global(strong) { font-weight: 600; }
  /* Pull-quote: een blockquote in de body springt eruit als kerncijfer/kernzin. */
  .case-body :global(blockquote) {
    margin: 32px 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--color-v2-olijf-fel);
    font-family: var(--font-newsreader);
    font-style: italic;
    font-weight: 400;
    font-size: 26px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink-diep);
  }
  .case-body :global(blockquote p) { margin: 0; }
</style>
