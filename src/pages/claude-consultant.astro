---
import { getEntry } from 'astro:content';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BasisLayout from '../layouts/BasisLayout.astro';
import DienstKop from '../components/DienstKop.astro';
import { dienstNode, dienstId, faqNode } from '../lib/schema';
import { site, auteurs } from '../site';

// Prijzen komen rechtstreeks uit de diensten-content (één bron van waarheid).
const scan = await getEntry('diensten', 'readiness-scan');
const rollout = await getEntry('diensten', 'rollout');
const retainer = await getEntry('diensten', 'retainer');
if (!scan || !rollout || !retainer) throw new Error('Diensten-content ontbreekt');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Claude consultant', url: '/claude-consultant' },
];

const werk = [
  {
    kop: 'Processen doorlichten en use cases ranken',
    tekst: 'We lopen je afdelingen langs en zoeken de taken waar Claude echt tijd oplevert. Je krijgt een lijst van vijf tot tien concrete use cases, gerangschikt op ROI.',
  },
  {
    kop: 'Claude Team of Enterprise veilig inrichten',
    tekst: 'Seats, SSO, verwerkersovereenkomst en duidelijke afspraken over welke data wel en niet in Claude gaat. De saaie kant, maar wel de kant waar het misgaat als niemand ernaar kijkt.',
  },
  {
    kop: 'Een promptbibliotheek op maat bouwen',
    tekst: 'Tien tot dertig prompts, toegespitst op jouw use cases en geschreven met je echte documenten en processen. Geen generieke voorbeelden uit een cursus.',
  },
  {
    kop: 'Koppelingen met je stack',
    tekst: 'Waar het zin heeft, koppelen we Claude aan je eigen systemen via een MCP-server: je CRM, je rapportage-omgeving, je kennisbank. Alleen als de scan aantoont dat het de investering waard is.',
  },
  {
    kop: 'Champions trainen',
    tekst: 'Twee tot vier mensen uit je eigen team worden intensief getraind als kennisdragers. Zij houden het draaiend als wij weg zijn.',
  },
];

const prijzen = [
  { naam: scan.data.titel, prijs: scan.data.prijs, duur: scan.data.duur, link: '/claude-readiness-scan' },
  { naam: rollout.data.titel, prijs: rollout.data.prijs, duur: rollout.data.duur, link: '/claude-in-30-dagen' },
  { naam: retainer.data.titel, prijs: retainer.data.prijs, duur: retainer.data.duur, link: '/claude-compagnon' },
];

const voorbeelden = [
  {
    cijfer: '5 min',
    kop: 'Vergadernotities naar actiepunten bij een IT-consultancy',
    tekst: 'Klantgesprekken van een uur werden opgenomen maar niemand keek ze echt terug. Nu maakt een Claude Code-skill er in vijf minuten een gestructureerde brief van, met de videoclips op de juiste plek. Dat was 45 minuten handwerk.',
    slug: 'consultant-brief',
  },
  {
    cijfer: '€0',
    kop: 'Een eigen CRM-stack in één weekend',
    tekst: 'Drie losse tools, 180 euro per maand, en data die nergens samenkwam. In één weekend vervangen door een eigen open-source CRM-stack: nul euro licentiekosten en volledige controle over de klantdata.',
    slug: 'crm-weekend',
  },
  {
    cijfer: '38',
    kop: 'Achtergrondprocessen doorgelicht bij een SaaS-bedrijf',
    tekst: 'Een dagelijkse data-sync bleek al twee weken stil te staan zonder dat iemand het merkte. We inventariseerden alle 38 achtergrondprocessen; 9 bleken kapot en zijn gerepareerd én gedocumenteerd.',
    slug: 'automation-audit',
  },
];

// Case-diagrammen als stand-in voor de nog aan te leveren projectbeelden
// (zelfde inlaadpatroon als cases/[slug].astro).
const diagrams = Object.fromEntries(
  voorbeelden.map((v) => [v.slug, readFileSync(resolve('src/assets/diagrams', `${v.slug}.svg`), 'utf-8')])
);

const faqItems = [
  {
    question: 'Wat doet een Claude-consultant precies?',
    answer: 'Een Claude-consultant helpt je bedrijf om Claude van experiment naar dagelijks gereedschap te brengen: use cases vinden en ranken, de omgeving veilig inrichten, een promptbibliotheek bouwen, koppelingen met je systemen maken en je team trainen. Bij ons is dat één traject van scan tot rollout, geen los advies.',
  },
  {
    question: 'Wat kost een Claude-consultant?',
    answer: `Wij werken met vaste prijzen per stap: de Readiness Scan kost ${scan.data.prijs.toLowerCase()}, de rollout van vier weken ${rollout.data.prijs.toLowerCase()} en doorlopende begeleiding ${retainer.data.prijs.toLowerCase()}. Na de scan krijg je een vaste offerte voor de rollout, dus je weet vooraf waar je aan toe bent.`,
    linkHref: '/prijs',
    linkTekst: 'Bekijk het prijzenoverzicht',
  },
  {
    question: 'Werken jullie op uurbasis?',
    answer: 'Nee, in principe niet. Elke stap heeft een vaste prijs en een helder eindresultaat. De enige uitzondering is integratie-coaching bovenop de rollout; die kan per uur. Zo weet je vooraf wat je betaalt en wat je krijgt.',
  },
  {
    question: 'Wat is het verschil met een gewone AI-consultant?',
    answer: 'Een generieke AI-consultant adviseert over elke tool tegelijk en levert een presentatie met een roadmap. Wij werken alleen met Claude en blijven tot en met het dagelijks gebruik: installatie, prompts, training, adoptiemeting. Het eindresultaat is een team dat zelfstandig met Claude werkt, geen rapport in een la.',
  },
  {
    question: 'Kun je Claude zo inrichten dat je aan de AVG voldoet?',
    answer: 'Ja. Via de zakelijke voorwaarden van Anthropic traint Claude niet op jouw data en is er een verwerkersovereenkomst (DPA). Wij richten dat in, samen met SSO en afspraken over welke data wel en niet in prompts gaat. Op onze compliance-pagina staat de uitleg in gewoon Nederlands.',
    linkHref: '/compliance',
    linkTekst: 'Naar het compliance-overzicht',
  },
  {
    question: 'Kunnen we starten als niemand bij ons ervaring met AI heeft?',
    answer: 'Ja, dat is juist de doelgroep. Alles wordt uitgelegd in het Nederlands, zonder jargon, en we werken met jouw echte documenten en processen. Begin met de gratis AI-check: die laat in twee minuten zien of je bedrijf er klaar voor is.',
    linkHref: '/ai-enablement-scan',
    linkTekst: 'Doe de gratis AI-check',
  },
];

const schemaFaq = faqItems.map(({ question, answer }) => ({ question, answer }));
---
<BasisLayout
  titel="Claude consultant: je vaste Claude-specialist"
  beschrijving="Claude consultant voor het Nederlandse MKB: één vaste specialist die Claude met je team inricht, in gewoon Nederlands. Vaste prijzen vanaf €1.500."
  pad="/claude-consultant"
  schema={{
    breadcrumbs,
    // Geen Person-node hier: Service.provider blijft de organisatie; Camiels Person-node staat op /over.
    hoofdonderwerp: dienstId('/claude-consultant'),
    nodes: [
      dienstNode({
        pad: '/claude-consultant',
        naam: 'Claude consultant',
        beschrijving: 'Claude-consultant voor het Nederlandse MKB: implementatie, training en begeleiding met vaste prijzen.',
        serviceType: 'Claude-consultancy',
        catalogus: prijzen.map((r) => ({ naam: r.naam, prijsTekst: r.prijs, url: r.link, dienstPad: r.link })),
      }),
      faqNode('/claude-consultant', schemaFaq),
    ],
  }}
>

  <article class="v2-artikel">
    <DienstKop breadcrumbs={breadcrumbs} label="Dienst" h1="Claude consultant voor het Nederlandse MKB">
      <p>
        Een Claude consultant kent één tool goed en blijft tot je team er zelfstandig mee werkt: installeren, inrichten, trainen en meekijken tot het dagelijks gebruik loopt.
      </p>
      <p>
        We werken voor Nederlandse MKB-bedrijven van tien tot tweehonderd mensen,
        in gewoon Nederlands, voor teams die vaak nog nooit serieus met AI hebben
        gewerkt.
      </p>
      <figure slot="beeld" class="v2-dienst-foto">
        <img
          src="/team/camiel-presentatie.jpg"
          alt="Camiel Wits geeft een workshop met microfoon"
          width="1280" height="852"
          style="object-position: 50% 15%;"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="v2-glas">8+ jaar data &amp; AI</figcaption>
      </figure>
    </DienstKop>

    <section class="v2-sectie">
      <h2>Wat een Claude consultant bij ons concreet doet</h2>
      <div class="v2-werk">
        {werk.map((w, i) => (
          <div class:list={['v2-werk-kaart', i === 4 && 'v2-werk-breed']}>
            <p class="v2-werk-nr">{`0${i + 1}`}</p>
            <div>
              <h3>{w.kop}</h3>
              <p>{w.tekst}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="v2-sectie-noot">
        Dat werk zit verpakt in twee stappen: eerst de
        <a href="/claude-readiness-scan">Readiness Scan</a> (weten wat er kan en wat het oplevert),
        daarna de rollout <a href="/claude-in-30-dagen">Claude in 30 dagen</a> (zorgen dat het echt gebeurt).
        Wie daarna wil doorpakken, doet dat met de <a href="/claude-compagnon">Claude Compagnon</a>.
      </p>
    </section>

    <section class="v2-sectie">
      <div class="v2-persoon">
        {/* FOTO: definitieve portretfoto van Camiel (staand, min. ~440×520; weergave 220×260, object-fit: cover) — nu de bestaande avatarfoto als stand-in. */}
        <img
          src="/team/camiel-avatar.jpg"
          alt="Portret van Camiel Wits"
          width="220" height="260"
          class="foto-warm"
          loading="lazy"
        />
        <div>
          <h2>Wie je aan de lijn krijgt</h2>
          <p>
            Het werk doet {auteurs.camiel.naam}, {auteurs.camiel.functie.toLowerCase()} met meer dan 8 jaar ervaring met data en AI. Hij doet de Readiness Scan, geeft de workshops en zit bij de kwartaalreviews.
          </p>
          <p class="text-sm">
            <a href="/over">Lees meer over onze aanpak</a>
            <span class="text-inkt-zacht"> of </span>
            <a href={auteurs.camiel.linkedin} target="_blank" rel="noopener">bekijk Camiel op LinkedIn</a>
          </p>
          <p class="text-sm">
            <a
              href="https://open.spotify.com/episode/5pxbh8B6VEwyhJFdB92PCQ"
              target="_blank"
              rel="noopener"
              class="v2-persoon-podcast"
            >
              Beluister Camiel in De Dataloog<span class="sr-only"> (opent in nieuw venster)</span> &rarr;
            </a>
          </p>
        </div>
        {/* MENS: (voor Camiel) één zin over waarom klanten meestal bellen — welke vraag stellen ze letterlijk als ze een "Claude consultant" zoeken? Dat maakt deze sectie herkenbaar. */}
      </div>
    </section>

    <section class="v2-sectie">
      <h2>Wat kost een Claude consultant?</h2>
      <p class="v2-sectie-intro">
        Elke stap heeft een vaste prijs en een helder
        eindresultaat, en de prijzen staan gewoon online:
      </p>
      <div class="v2-tabelkaart">
        <table>
          <thead>
            <tr>
              <th>Stap</th>
              <th>Prijs</th>
              <th>Duur</th>
            </tr>
          </thead>
          <tbody>
            {prijzen.map((rij) => (
              <tr>
                <td><a href={rij.link}>{rij.naam}</a></td>
                <td>{rij.prijs}</td>
                <td>{rij.duur}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="v2-sectie-noot">
        Optioneel: een custom MCP-server voor je stack (&euro;2.000 tot &euro;5.000)
        of integratie-coaching per uur. De Claude-licenties zelf lopen rechtstreeks
        via Anthropic; zie het <a href="/prijs">prijzenoverzicht</a>.
        Meer over wat een compleet traject inhoudt staat op de pagina over
        <a href="/claude-implementatie">Claude-implementatie</a>.
      </p>
    </section>

    <section class="v2-sectie">
      <h2>Werk dat we eerder deden</h2>
      <p class="v2-sectie-intro">Drie voorbeelden die ons team eerder bouwde bij Nederlandse IT-bedrijven, met cijfers.</p>
      <div class="v2-bewijs">
        {voorbeelden.map((v) => (
          <article>
            {/* FOTO: eigen foto of screenshot van het project (liggend 16:9, min. ~700×400; weergave 150px hoog, object-fit: cover) — nu het SVG-diagram van de case als stand-in. */}
            <div class="v2-bewijs-beeld" set:html={diagrams[v.slug]} />
            <span class="v2-bewijs-cijfer">{v.cijfer}</span>
            <h3>{v.kop}</h3>
            <p>{v.tekst}</p>
            <a href={`/cases/${v.slug}`}>Lees de case &rarr;</a>
          </article>
        ))}
      </div>
      <p class="v2-sectie-noot">
        Alle projecten staan bij de <a href="/cases">cases</a>.
        Hoe we werken staat op de <a href="/methodologie">methodologie-pagina</a>;
        de AVG-kant leggen we uit op de <a href="/compliance">compliance-pagina&rsquo;s</a>.
      </p>
    </section>

    <section class="v2-sectie v2-dienst-faq">
      <h2>Veelgestelde vragen over een Claude consultant</h2>
      <div class="v2-faq-lijst">
        {faqItems.map(item => (
          <details class="v2-faq-item">
            <summary class="v2-faq-vraag">
              {item.question}
              <span class="v2-faq-plus" aria-hidden="true">+</span>
            </summary>
            <div class="v2-faq-antwoord">
              {item.answer}
              {item.linkHref && (
                <a href={item.linkHref}>{item.linkTekst} &rarr;</a>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  </article>

  <section class="v2-sectie">
    <div class="v2-band v2-band-foto">
      <div class="v2-band-binnen">
        <h2 class="v2-band-h2">Even sparren met een Claude consultant?</h2>
        <p class="mt-3">Vraag een intro-gesprek van 30 minuten aan, rechtstreeks met Camiel. Geen salesteam ertussen. Past het van beide kanten, dan begint het traject met de Readiness Scan.</p>
        <a href={site.introLink} class="v2-knop v2-knop-wit mt-6">
          Vraag een intro-gesprek aan
        </a>
      </div>
      {/* Onder 900px vervalt de foto (zelfde gedrag als de eerdere placeholder). */}
      <img
        src="/team/camiel-studio.jpg"
        alt="Camiel Wits in gesprek aan de studiotafel"
        loading="lazy"
      />
    </div>
  </section>
</BasisLayout>
