---
import BasisLayout from '../layouts/BasisLayout.astro';
---
<BasisLayout
  titel="Pagina niet gevonden"
  beschrijving="Deze pagina bestaat niet. Ga terug naar de homepagina."
  pad="/404"
  geenCanonical
>
  <section class="v2-404">
    <p class="v2-404-getal">404</p>
    <h1 class="v2-artikel-h1">Deze pagina bestaat niet</h1>
    <p class="v2-hub-lead">Waarschijnlijk een oude link of een typfout. Terug naar het begin.</p>
    <a
      href="/"
      class="v2-knop v2-knop-olijf mt-8"
    >
      Naar de homepagina
    </a>
  </section>
</BasisLayout>
