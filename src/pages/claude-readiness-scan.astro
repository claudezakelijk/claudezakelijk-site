---
import { getEntry, render } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import CtaBlok from '../components/CtaBlok.astro';
import Broodkruimel from '../components/Broodkruimel.astro';
import { site } from '../site';
import { dienstNode, dienstId } from '../lib/schema';

const dienst = await getEntry('diensten', 'readiness-scan');
if (!dienst) throw new Error('Diensten-entry readiness-scan ontbreekt');
const { Content } = await render(dienst);
const beschrijving = 'Claude Readiness Scan vanaf €1.500: een dag op locatie, binnen een week een Nederlands rapport met gerangschikte use cases en een heldere vervolgofferte.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Claude Readiness Scan', url: dienst.data.pad }];
---
<BasisLayout
  titel={dienst.data.titleTag ?? dienst.data.titel}
  beschrijving={beschrijving}
  pad={dienst.data.pad}
  schema={{
    breadcrumbs,
    hoofdonderwerp: dienstId(dienst.data.pad),
    nodes: [dienstNode({ pad: dienst.data.pad, naam: dienst.data.titel, beschrijving, serviceType: 'AI-readiness-assessment voor Claude', aanbod: { naam: dienst.data.titel, prijsTekst: dienst.data.prijs, url: dienst.data.pad } })],
  }}
>
  <div class="max-w-3xl mx-auto px-6 pt-16"><Broodkruimel items={breadcrumbs} /></div>
  <article class="max-w-3xl mx-auto px-6 pt-6 pb-8 prose prose-lg">
    <p class="text-xs uppercase tracking-widest text-inkt-zacht">{dienst.data.ondertitel}</p>
    <h1>{dienst.data.h1 ?? dienst.data.titel}</h1>
    <dl class="grid grid-cols-2 gap-4 text-sm mt-6 not-prose">
      <div><dt class="text-inkt-zacht">Prijs</dt><dd class="font-semibold">{dienst.data.prijs}</dd></div>
      <div><dt class="text-inkt-zacht">Duur</dt><dd class="font-semibold">{dienst.data.duur}</dd></div>
    </dl>
    <div class="mt-8">
      <Content />
    </div>
    <p class="mt-8 text-sm text-inkt-zacht">Eerst zelf kijken of je bedrijf er klaar voor is? De <a href="/ai-enablement-scan">gratis AI-check</a> duurt twee minuten.</p>
  </article>
  <CtaBlok
    kop="Scan aanvragen?"
    tekst="Vraag een intro van 30 minuten aan. Past het van beide kanten, dan boeken we de scan-dag."
    link={site.introLink}
    linkTekst="Vraag een intro-gesprek aan"
  />
</BasisLayout>
