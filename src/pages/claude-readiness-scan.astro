---
import { getEntry, render } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import CtaBlok from '../components/CtaBlok.astro';
import DienstKop from '../components/DienstKop.astro';
import DienstBeeld from '../components/DienstBeeld.astro';
import ArtikelInhoud from '../components/ArtikelInhoud.astro';
import { site } from '../site';
import { dienstNode, dienstId } from '../lib/schema';

const dienst = await getEntry('diensten', 'readiness-scan');
if (!dienst) throw new Error('Diensten-entry readiness-scan ontbreekt');
const { Content, headings } = await render(dienst);
const beschrijving = 'Claude Readiness Scan vanaf €1.500: een dag op locatie, binnen een week een Nederlands rapport met gerangschikte use cases en een heldere vervolgofferte.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Claude Readiness Scan', url: dienst.data.pad }];
---
<BasisLayout
  titel={dienst.data.titleTag ?? dienst.data.titel}
  beschrijving={beschrijving}
  pad={dienst.data.pad}
  schema={{
    breadcrumbs,
    hoofdonderwerp: dienstId(dienst.data.pad),
    nodes: [dienstNode({ pad: dienst.data.pad, naam: dienst.data.titel, beschrijving, serviceType: 'AI-readiness-assessment voor Claude', aanbod: { naam: dienst.data.titel, prijsTekst: dienst.data.prijs, url: dienst.data.pad } })],
  }}
>
  <article class="v2-artikel">
    <DienstKop
      breadcrumbs={breadcrumbs}
      label={dienst.data.ondertitel}
      h1={dienst.data.h1 ?? dienst.data.titel}
      feiten={[{ term: 'Prijs', waarde: dienst.data.prijs }, { term: 'Duur', waarde: dienst.data.duur }]}
    >
      <DienstBeeld slot="beeld" soort="scan" />
    </DienstKop>

    <div class="v2-artikel-raster">
      <ArtikelInhoud soort="zijkant" koppen={headings} />
      <div class="v2-artikel-tekst">
        <ArtikelInhoud soort="mobiel" koppen={headings} />
        <div class="prose prose-lg max-w-none v2-prose">
          <Content />
        </div>
        <p class="mt-10 text-inkt-zacht">Eerst zelf kijken of je bedrijf er klaar voor is? De <a href="/ai-enablement-scan">gratis AI-check</a> duurt twee minuten.</p>
      </div>
    </div>
  </article>
  <CtaBlok
    kop="Scan aanvragen?"
    tekst="Vraag een intro van 30 minuten aan. Past het van beide kanten, dan boeken we de scan-dag."
    link={site.introLink}
    linkTekst="Vraag een intro-gesprek aan"
  />
</BasisLayout>
