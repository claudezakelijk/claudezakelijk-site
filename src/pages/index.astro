---
// Merkregel: nooit "officieel", "partner" of "specialist" in relatie tot Anthropic of Claude; zie docs/seo-improvement/specs/D-trust-legal-entity.md (D-11).
// Redesign v2 (27 okt): tekst
// letterlijk gelijk aan 1b, alleen vormgeving en sectievolgorde gewijzigd.
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import camielWater from '../assets/team/camiel-water.jpg';
import studioBreed from '../assets/team/studio-breed.jpg';
import camielPresentatie from '../assets/team/camiel-presentatie.jpg';
import BasisLayout from '../layouts/BasisLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ZorgBeeld from '../components/home/ZorgBeeld.astro';
import { auteurs, site } from '../site';
import '../styles/home-v2.css';

const diensten = (await getCollection('diensten'))
  .filter((d) => d.data.opnemenOpHome)
  .sort((a, b) => a.data.volgorde - b.data.volgorde);

const stapLabels = ['Stap één', 'Stap twee', 'Stap drie'];

const zorgen = [
  { cat: 'Veiligheid', q: 'Bang dat Claude dingen sloopt', a: "Claude draait in een afgesloten omgeving. Je ziet elke wijziging voordat die doorgaat en je kunt alles terugdraaien. Geen verrassingen." },
  { cat: 'Compliance', q: 'Hoe zit het met AVG?', a: "Claude for Work traint niet op je data en heeft SSO en een verwerkersovereenkomst. Je data wordt opgeslagen in de Verenigde Staten. Moet alles in de EU blijven, dan kan dat via AWS Bedrock of Google Vertex AI. We leggen het in gewoon Nederlands uit, zonder juridisch geneuzel. En mogen klantnamen en persoonsgegevens Anthropic helemaal niet bereiken? Dan pseudonimiseren we je data op je eigen systemen voordat die naar Claude gaat, en zetten we de echte namen pas terug als het antwoord binnen is. Dat richten we voor je in." },
  { cat: 'Ontslagen', q: 'Moet ik mensen ontslaan?', a: "Nee. Het hele punt is 10x je huidige team, niet een kleiner team. Niemand eruit, iedereen wordt beter in z'n werk." },
  { cat: 'Complexiteit', q: 'Te technisch voor mijn team', a: "We leggen het uit zodat iedereen het snapt, ook zonder AI-ervaring. We werken met jouw echte documenten en processen, geen neppe voorbeelden. Twee tot vier mensen uit je team worden champion en dragen de kennis verder." },
] as const;

const vergelijking = [
  ['Advies over elke tool tegelijk', 'Een tool, tot op het bot'],
  ['Presentatie en roadmap', 'Installatie tot en met dagelijks gebruik'],
  ['Ontslagen verstopt in het ROI-model', '10x je huidige team, niemand eruit'],
  ['Engelstalige frameworks', 'Gewoon Nederlands, voor mensen die nieuw zijn met AI'],
  ['Uurtjes tikken', 'Vaste prijs, helder resultaat'],
];

// Bewezen ervaring van het team (bron: fractionalaiteam.nl, Camiels site — overgenomen
// op verzoek Sweder 22 juli 2026). Logo's in public/logos/, framing conform
// eerlijkheidsregel: "Eerdere opdrachtgevers van ons team".
const ervaring = [
  { num: '8+ jaar', title: 'Ervaring met AI', sub: 'In meer dan 6 verschillende sectoren' },
  { num: '100+', title: 'Praktijkvoorbeelden', sub: 'Geschaald naar miljoenen klanten en duizenden medewerkers' },
  { num: '22+', title: 'Presentaties, workshops en trainingen', sub: 'Essentieel voor je AI-geletterdheid' },
];
const opdrachtgevers = [
  { naam: 'Vodafone', logo: '/logos/vodafone.svg' },
  { naam: 'PostNL', logo: '/logos/postnl.svg' },
  { naam: 'De Nederlandsche Bank', logo: '/logos/dnb.svg' },
  { naam: 'Gemeente Amsterdam', logo: '/logos/gemeente-amsterdam.svg' },
  { naam: 'CNV', logo: '/logos/cnv.svg' },
  { naam: 'Haven van Amsterdam', logo: '/logos/haven-amsterdam.svg' },
  { naam: 'Visma | Raet', logo: '/logos/visma-raet.png' },
  { naam: 'TheRippleCo', logo: '/logos/therippleco.png' },
];

// Illustratieve taken in het werkplek-venster van de hero (goedgekeurd door Sweder, 27 okt).
const taken = [
  ['Offertes samenvatten', 'Alle aanvragen van deze week op een rij'],
  ['Klantmail beantwoorden', 'In jullie eigen toon'],
  ['Notulen uitwerken', 'Met actiepunten per persoon'],
  ['Contract nalopen', 'Afwijkingen gemarkeerd'],
];
const weken = [['Week 1', 'Kickoff-workshop'], ['Week 2', 'Champions'], ['Week 3', 'Promptbibliotheek'], ['Week 4', 'Verdieping']];
---
<BasisLayout
  titel="Claude zakelijk inzetten voor het MKB | Implementeren.ai"
  beschrijving="Claude zakelijk inzetten in je MKB? Wij richten Claude veilig in, trainen je team op eigen werk en werken met vaste prijzen. Begin met de gratis AI-check."
  pad="/"
  schema={{ personen: ['camiel'] }}
>
  <div class="v2-home">
    <!-- 1. Hero: kop statisch (LCP), werkplek-venster schuift omhoog -->
    <section class="v2-hero">
      <div class="v2-gloed" aria-hidden="true"></div>
      <div class="v2-hero-tekst">
        <p class="v2-pil"><img src={auteurs.camiel.foto} alt="" width="28" height="28" />Jouw team × AI</p>
        <h1>Claude zakelijk inzetten in jouw <span class="v2-accent">MKB</span></h1>
        <p class="v2-hero-lead">Wij richten Claude in bij je bedrijf en blijven tot je team er zelf mee werkt.</p>
        <div class="v2-knoppen">
          <a href="/ai-enablement-scan" class="v2-knop v2-knop-olijf">Doe de gratis AI-check <span aria-hidden="true">&rarr;</span></a>
          <a href="/claude-readiness-scan" class="v2-knop v2-knop-licht">Bekijk de Readiness Scan</a>
        </div>
        <p class="v2-hero-noot">Doe de gratis AI-check en kijk of AI-coaching past bij je bedrijf. Zo ja, dan volgt een gratis intro-gesprek.</p>
      </div>
      <div class="v2-werkplek">
        <div class="v2-werkplek-rand">
          <div class="v2-werkplek-scherm">
            <div class="v2-werkplek-taak" aria-hidden="true">
              <p class="v2-werkplek-groet"><span class="v2-bol"></span>Goedemorgen. Waar zal ik mee helpen?<span class="v2-voorbeeld">Voorbeeld</span></p>
              <div class="v2-taken">
                {taken.map(([t, s]) => <div><strong>{t}</strong><span>{s}</span></div>)}
              </div>
              <div class="v2-invoer">
                <span class="v2-invoer-tekst"><span data-typ="Zet de offerteaanvragen op een rij">Zet de offerteaanvragen op een rij</span><span class="v2-caret"></span></span>
                <span class="v2-verstuur">↑</span>
              </div>
            </div>
            <figure class="v2-werkplek-foto">
              <Picture
                src={camielWater}
                alt="Camiel Wits, lachend in gesprek aan het water"
                formats={['avif', 'webp']}
                widths={[320, 480, 640, 828]}
                sizes="(min-width: 1080px) 340px, (min-width: 768px) 40vw, calc(100vw - 64px)"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <figcaption>Camiel Wits, lead consultant</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Logo-band (sociaal bewijs direct onder de hero) -->
    <section class="v2-logos">
      <div class="v2-wrap">
        <p class="v2-logos-label"><strong>Eerdere opdrachtgevers van ons team</strong>Ons team werkte bij deze organisaties eerder aan AI- en dataprojecten, vóór Implementeren.ai.</p>
        <LogoMarquee logos={opdrachtgevers} />
      </div>
    </section>

    <!-- 3. Drie manieren: links vast, rechts stapelkaarten -->
    <section class="v2-wrap v2-stappen">
      <div class="v2-stappen-intro">
        <h2>Drie manieren om te beginnen</h2>
        <p class="v2-zacht">Eerst een audit, dan rollout, dan retainer. Elke stap staat los. Je gaat pas door als de vorige stap z'n geld waard was.</p>
        <p class="v2-stappen-noot"><strong>Audit</strong> <span aria-hidden="true">&rarr;</span> <strong>Rollout</strong> <span aria-hidden="true">&rarr;</span> <strong>Retainer</strong> &nbsp;·&nbsp; elke stap staat los, doorgaan is altijd jouw keuze</p>
        <p class="v2-stappen-noot">Hoe de stappen op elkaar aansluiten en wat het samen kost, lees je bij <a href="/claude-implementatie">Claude-implementatie</a>. Wie het werk doet, staat bij <a href="/claude-consultant">Claude-consultant</a>.</p>
      </div>
      <div class="v2-kaarten">
        {diensten.map((d, i) => {
          // "Vanaf €1.500 per maand" → groot "€1.500" + klein "per maand, vanaf".
          const kaal = d.data.prijs.replace(/^Vanaf\s+/i, '');
          const perMaand = /per maand/i.test(kaal);
          const bedrag = kaal.replace(/\s*per maand/i, '');
          return (
            <article class:list={['v2-kaart', i === 2 && 'v2-kaart-donker']}>
              <div class="v2-kaart-tekst">
                <p class="v2-kaart-stap">{stapLabels[i]}: {d.data.ondertitel.toLowerCase()}{i === 1 && <span class="v2-meest">Meest gekozen</span>}</p>
                <h3>{d.data.titel}</h3>
                <p class="v2-kaart-prijs"><strong>{bedrag}</strong> {perMaand ? 'per maand, vanaf' : 'eenmalig, vanaf'}</p>
                <ul>
                  {d.data.punten.map((punt) => (
                    <li><span aria-hidden="true">&#10003;</span><span>{punt}</span></li>
                  ))}
                </ul>
                <a href={d.data.pad} class="v2-kaart-link">Lees details</a>
              </div>
              <div class="v2-kaart-beeld" aria-hidden="true">
                {i === 0 && (
                  <div class="v2-rapport">
                    <p class="v2-rapport-kop">Readiness Scan</p>
                    <div class="v2-balk">1 <i style="width: 88%"></i></div>
                    <div class="v2-balk">2 <i style="width: 70%"></i></div>
                    <div class="v2-balk">3 <i style="width: 54%"></i></div>
                    <div class="v2-balk">4 <i style="width: 36%"></i></div>
                  </div>
                )}
                {i === 1 && (
                  <div class="v2-weken">
                    {weken.map(([w, t]) => <div class="v2-week"><b>{w}</b>{t}</div>)}
                  </div>
                )}
                {i === 2 && (
                  <div class="v2-gesprek">
                    <div class="v2-bubbel"><small>Medewerker</small>Kan Claude ook onze inkoopfacturen controleren?</div>
                    <div class="v2-bubbel v2-bubbel-ons"><small>Camiel · {site.naam}</small>Ja. We zetten er deze week een vaste prompt voor in de bibliotheek.</div>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 4. Wat houdt je tegen: stappenverhaal, beeld wisselt mee -->
    <section class="v2-zorgen-sectie">
      <div class="v2-wrap v2-zorgen" data-actief="0">
        <div>
          <div class="v2-zorgen-kop reveal-target">
            <h2>Wat houdt je tegen?</h2>
            <p class="v2-zacht">Vier zorgen die bijna elke ondernemer heeft over AI. En vier eerlijke antwoorden.</p>
          </div>
          <ol class="v2-zorg-lijst">
            {zorgen.map((z, i) => (
              <li class="v2-zorg" data-actief={i === 0 ? '' : undefined}>
                <p class="v2-zorg-cat">{z.cat}</p>
                <h3>{z.q}</h3>
                <p class="v2-zorg-antwoord">{z.a}</p>
                <div class="v2-zorg-beeld-mobiel"><ZorgBeeld nr={i as 0 | 1 | 2 | 3} /></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="v2-zorg-podium" aria-hidden="true">
          {zorgen.map((_, i) => (
            <div class="v2-podium-beeld" data-beeld={i}><ZorgBeeld nr={i as 0 | 1 | 2 | 3} /></div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Wie zijn wij: citaat kleurt woord voor woord in -->
    <section class="v2-wrap v2-wie">
      <div>
        <p class="v2-label">Wie zijn wij</p>
        <p class="v2-citaat"><span class="v2-onthul">Geen bureau dat een rapport aflevert. Een team dat Claude bij je installeert en blijft tot het werkt.</span></p>
        <div class="v2-persoon">
          <img src={auteurs.camiel.foto} alt="" width="56" height="56" loading="lazy" />
          <p>
            <span class="v2-zacht" style="font-size: 13px">Je vaste aanspreekpunt</span><br />
            <strong>{auteurs.camiel.naam}</strong><br />
            <span class="v2-zacht">{auteurs.camiel.functie}</span>
            {auteurs.camiel.linkedin && (
              <><br /><a href={auteurs.camiel.linkedin} target="_blank" rel="noopener" style="font-size: 14px">LinkedIn<span class="sr-only"> (opent in nieuw venster)</span></a></>
            )}
          </p>
        </div>
        <p class="v2-zacht" style="margin: 24px 0 0">Je werkt direct met de mensen die het bouwen. Geen salesteam, geen junior die het rapport schrijft.</p>
        <a href="/over" style="display: inline-block; margin-top: 14px; font-weight: 600">Lees meer over ons <span class="cta-arrow">&rarr;</span></a>
      </div>
      <figure class="v2-wie-foto reveal-target">
        <Picture
          src={studioBreed}
          alt="Panelgesprek over data en AI aan een studiotafel"
          formats={['avif', 'webp']}
          widths={[480, 640, 828, 1080]}
          sizes="(min-width: 1240px) 480px, (min-width: 900px) 40vw, calc(100vw - 48px)"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <!-- 6. Bewezen ervaring: foto met glazen cijferkaarten -->
    <section class="v2-wrap">
      <div class="v2-ervaring">
        <Picture
          src={camielPresentatie}
          alt="Camiel Wits geeft een workshop met microfoon"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1240px) 1192px, calc(100vw - 48px)"
          loading="lazy"
          decoding="async"
        />
        <div class="v2-ervaring-in">
          <h2>Bewezen ervaring</h2>
          <p class="v2-ervaring-lead">Geen theorie: ons team bouwde jarenlang AI- en dataprojecten bij grote en kleine organisaties.</p>
          <div class="v2-cijfers">
            {ervaring.map((e) => (
              <div class="v2-cijfer reveal-target">
                <p class="v2-cijfer-num" data-tel>{e.num}</p>
                <p class="v2-cijfer-titel">{e.title}</p>
                <p class="v2-cijfer-sub">{e.sub}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="v2-ervaring-onder">Workshop op locatie: Claude uitleggen aan mensen die er morgen mee moeten werken</p>
    </section>

    <!-- 7. Waarom niet gewoon een AI-consultant? -->
    <section class="v2-wrap v2-verschil">
      <div class="v2-verschil-kop reveal-target">
        <h2>Waarom niet gewoon een AI-consultant?</h2>
        <p class="v2-zacht">Er zijn genoeg consultants die iets over AI roepen. Dit is wat hier anders is.</p>
      </div>
      <div class="v2-kolommen">
        <div class="v2-kolom v2-kolom-oud reveal-target">
          <h3>De standaard AI-consultant</h3>
          <ul>{vergelijking.map(([oud]) => <li><span class="v2-teken" aria-hidden="true">&#10005;</span>{oud}</li>)}</ul>
        </div>
        <div class="v2-kolom v2-kolom-nieuw reveal-target">
          <h3>Hoe wij het doen</h3>
          <ul>{vergelijking.map(([, nieuw]) => <li><span class="v2-teken" aria-hidden="true">&#10003;</span>{nieuw}</li>)}</ul>
        </div>
      </div>
      <p class="v2-verschil-citaat reveal-target">"Dit werkt omdat het uit de praktijk komt, niet uit een whitepaper. Ons team draait zelf dagelijks op Claude, en dezelfde werkwijze zetten we bij jou neer."</p>
    </section>

    <!-- 8. Eerst zelf lezen: kennispijlers als bento (Spec C, C-09) -->
    <section class="v2-wrap v2-lezen">
      <h2>Eerst zelf lezen?</h2>
      <ul class="v2-bento">
        <li class="v2-groot reveal-target">
          <span class="v2-chips" aria-hidden="true"><span>Pro</span><span>Team</span><span class="v2-chip-olijf">Enterprise</span></span>
          <span><a href="/gids/claude-voor-mkb">Claude voor bedrijven en mkb</a>: welk abonnement past, wat het kost en hoe je begint.</span>
        </li>
        <li class="reveal-target">
          <span class="v2-teken-groot" aria-hidden="true">€</span>
          <span><a href="/prijs">Wat kost Claude zakelijk?</a> De prijzen van Pro, Team, Enterprise en de API.</span>
        </li>
        <li class="v2-donker reveal-target">
          <span class="v2-eu" aria-hidden="true">EU</span>
          <span><a href="/compliance">Is Claude AVG-proof?</a> Wat Anthropic regelt en wat jij zelf vastlegt.</span>
        </li>
        <li class="reveal-target">
          <span class="v2-chips" aria-hidden="true"><span>accountants</span><span>advocaten</span><span>makelaars</span></span>
          <span><a href="/verticalen">Claude per branche</a>: voor accountants, advocaten, makelaars en marketingbureaus.</span>
        </li>
        <li class="reveal-target">
          <span class="v2-vs" aria-hidden="true">Claude <b>vs</b> ChatGPT</span>
          <span><a href="/vergelijken">Claude vergelijken</a> met ChatGPT, Microsoft Copilot en Cursor.</span>
        </li>
      </ul>
    </section>

    <!-- 9. Slot-band -->
    <section class="v2-slot">
      <div class="v2-slot-band">
        <h2>Nieuwsgierig of Claude bij je bedrijf <span class="v2-accent">past</span>?</h2>
        <p>Doe de gratis AI-check. Je spreekt direct met de mensen die het werk doen, geen salesteam ertussen.</p>
        <div class="v2-slot-invoer">
          <span class="v2-invoer-tekst" aria-hidden="true"><span data-typ="Past Claude bij ons kantoor">Past Claude bij ons kantoor</span><span class="v2-caret"></span></span>
          <a href="/ai-enablement-scan" class="v2-knop v2-knop-donker">Doe de gratis AI-check</a>
        </div>
      </div>
    </section>
  </div>
</BasisLayout>

<script>
  import '../scripts/home-v2.ts';
</script>
