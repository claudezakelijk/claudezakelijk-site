---
import { site, navigatie as alleNavigatie, dienstenNavigatie } from '../site';
import { legeHubs } from '../data/indexering.mjs';
import LogoMerk from '../assets/logo/logo-mark.svg';

// Lege hubs ("Binnenkort meer", noindex) krijgen geen link; zie Footer.astro.
const navigatie = alleNavigatie.filter((i) => !legeHubs.includes(i.pad));
const huidigPad = Astro.url.pathname.replace(/\/$/, '') || '/';
// Logo: sitenaam met het laatste deel (bv. ".ai") in olijf.
const punt = site.naam.lastIndexOf('.');
const [logoMerk, logoStaart] = punt > 0 ? [site.naam.slice(0, punt), site.naam.slice(punt)] : [site.naam, ''];
---
<header class="v2-kop">
  <div class="v2-kop-balk">
    <a href="/" class="v2-logo"><LogoMerk class="v2-logo-merk" aria-hidden="true" focusable="false" />{logoMerk}<span>{logoStaart}</span></a>
    <nav aria-label="Hoofdnavigatie" class="desktop-nav">
      <ul>
        {navigatie.map((item) => (
          <li><a href={item.pad} aria-current={huidigPad === item.pad ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href="/ai-enablement-scan" class="v2-knop v2-knop-donker v2-knop-sm">Gratis AI-check <span aria-hidden="true">&rarr;</span></a></li>
      </ul>
    </nav>
    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Menu openen" aria-expanded="false" aria-controls="mobileNav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Mobile nav overlay + panel. Gesloten paneel is `inert` + visibility:hidden
     (zie global.css), zodat de off-screen links niet tabbaar zijn. -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-nav-panel" id="mobileNav" inert>
  <button class="close-btn" id="mobileCloseBtn" aria-label="Menu sluiten">&times;</button>
  <nav aria-label="Mobiele navigatie">
    {navigatie.map((item) => (<a href={item.pad}>{item.label}</a>))}
    {dienstenNavigatie.map((item) => (<a href={item.pad}>{item.label}</a>))}
    <a href="/ai-enablement-scan" class="v2-knop v2-knop-olijf">Gratis AI-check</a>
  </nav>
</div>

<script>
  const hamburger = document.getElementById('hamburgerBtn');
  const overlay = document.getElementById('mobileOverlay');
  const panel = document.getElementById('mobileNav');
  const closeBtn = document.getElementById('mobileCloseBtn');

  function setMenu(open: boolean) {
    overlay?.classList.toggle('open', open);
    panel?.classList.toggle('open', open);
    hamburger?.setAttribute('aria-expanded', String(open));
    if (open) {
      panel?.removeAttribute('inert');
      closeBtn?.focus();
    } else {
      panel?.setAttribute('inert', '');
    }
  }

  hamburger?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => {
    setMenu(false);
    hamburger?.focus();
  });
  overlay?.addEventListener('click', () => {
    setMenu(false);
    hamburger?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('open')) {
      setMenu(false);
      hamburger?.focus();
    }
  });
</script>
