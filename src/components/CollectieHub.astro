---
/**
 * Generiek overzichtstemplate voor collectie-hubpagina's (stap 1.3 / audit P0.5).
 * Volgt het patroon van de oorspronkelijke /nieuws- en /vergelijken-hubs:
 * eyebrow + H1 + intro, daarna een kaartgrid met alleen published entries,
 * of een nette lege staat zolang er nog niets gepubliceerd is.
 */
interface HubItem {
  href: string;
  titel: string;
  beschrijving: string;
  datum?: Date | null;
}

interface Props {
  /** Eyebrow boven de H1 én badge op elke kaart, bv. "Nieuws". */
  label: string;
  titel: string;
  intro: string;
  /** Tekst van de lees-link op elke kaart. */
  leesTekst?: string;
  /** Lege-staat-tekst zolang er nog geen published entries zijn. */
  leegTekst?: string;
  items: HubItem[];
}

const {
  label,
  titel,
  intro,
  leesTekst = 'Lees verder',
  leegTekst = 'Binnenkort meer: de eerste artikelen worden op dit moment geredigeerd.',
  items,
} = Astro.props;
---
<p class="text-xs uppercase tracking-widest text-inkt-zacht reveal-target">{label}</p>
<h1 class="mt-3 text-[length:var(--text-h1)] reveal-target">{titel}</h1>
<p class="mt-4 text-lg text-inkt-zacht max-w-2xl reveal-target">{intro}</p>

{items.length === 0 ? (
  <p class="mt-10 text-inkt-zacht reveal-target">{leegTekst}</p>
) : (
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {items.map((item) => (
      <a
        href={item.href}
        class="no-underline block rounded-lg border border-lijn bg-papier p-6 card-shadow reveal-target"
      >
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase tracking-widest text-inkt-zacht bg-papier-dieper rounded-full px-3 py-1">{label}</span>
          {item.datum && (
            <time class="text-xs text-inkt-zacht" datetime={item.datum.toISOString()}>
              {item.datum.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          )}
        </div>
        <h2 class="mt-3 font-serif text-xl font-bold text-inkt">{item.titel}</h2>
        <p class="mt-2 text-sm text-inkt-zacht">{item.beschrijving}</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent-donkerst">{leesTekst}<span class="cta-arrow">&rarr;</span></span>
      </a>
    ))}
  </div>
)}
