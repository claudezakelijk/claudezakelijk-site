---
interface Props {
  deadline: Date;
  label?: string;
  toelichting?: string;
}
const { deadline, label = 'Deadline', toelichting } = Astro.props;
const datumNl = deadline.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<div class="rounded-lg p-4 mb-8 border-l-4 border-teal bg-papier-dieper">
  <p class="font-semibold text-sm">{label}: {datumNl}</p>
  {toelichting && <p class="text-xs text-inkt-zacht mt-1">{toelichting}</p>}
</div>
