---
import { site, navigatie as alleNavigatie, dienstenNavigatie, kennisNavigatie as alleKennis } from '../site';
import { legeHubs } from '../data/indexering.mjs';

// Lege hubs ("Binnenkort meer", noindex) krijgen geen link. Zodra een collectie een
// gepubliceerd artikel heeft valt de hub uit legeHubs en komt de link vanzelf terug.
const zonderLegeHubs = <T extends { pad: string }>(items: readonly T[]) =>
  items.filter((i) => !legeHubs.includes(i.pad));
const navigatie = zonderLegeHubs(alleNavigatie);
const kennisNavigatie = zonderLegeHubs(alleKennis);
const jaar = new Date().getFullYear();
const linkClass = 'no-underline text-[rgba(250,247,242,0.55)] hover:text-papier transition-colors';
---
<footer class="bg-ink-diep text-[rgba(250,247,242,0.55)] border-t border-[rgba(250,247,242,0.12)]">
  <div class="wrap py-10 flex flex-col gap-10 md:flex-row md:justify-between text-[13.5px]">
    <div class="flex flex-col gap-2 max-w-xs">
      <span class="hp-italic text-[17px] text-papier">{site.naam}</span>
      <span>{site.tagline}.</span>
      <span class="mt-2">© {jaar} {site.naam}. Alle rechten voorbehouden.</span>
    </div>
    <div class="flex flex-wrap gap-10 md:gap-12">
      <div class="flex flex-col gap-2">
        <strong class="text-papier font-semibold">Diensten</strong>
        {dienstenNavigatie.map((i) => (<a href={i.pad} class={linkClass}>{i.label}</a>))}
      </div>
      <nav class="flex flex-col gap-2" aria-label="Voettekst-navigatie">
        <strong class="text-papier font-semibold">Meer</strong>
        {navigatie.map((i) => (<a href={i.pad} class={linkClass}>{i.label}</a>))}
      </nav>
      <div class="flex flex-col gap-2">
        <strong class="text-papier font-semibold">Kennis</strong>
        {kennisNavigatie.map((i) => (<a href={i.pad} class={linkClass}>{i.label}</a>))}
      </div>
      <div class="flex flex-col gap-2">
        <strong class="text-papier font-semibold">Contact</strong>
        <a href="/contact" class={linkClass}>Neem contact op</a>
        <a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a>
        <a href={site.linkedin} target="_blank" rel="noopener" class={linkClass}>LinkedIn<span class="sr-only"> (opent in nieuw venster)</span></a>
      </div>
    </div>
  </div>
  <div class="border-t border-[rgba(250,247,242,0.12)]">
    <div class="wrap py-4 text-[12.5px] text-[rgba(250,247,242,0.55)]">
      <p class="m-0">
        {site.naam} is een handelsnaam van {site.juridisch.handelsnaamVan}
        <span aria-hidden="true"> · </span>KvK {site.juridisch.kvk}
        <span aria-hidden="true"> · </span>BTW {site.juridisch.btw}
        <span aria-hidden="true"> · </span><a href="/privacy" class={linkClass}>Privacyverklaring</a>
      </p>
      <p class="mt-2 m-0">{site.onafhankelijkheid}</p>
    </div>
  </div>
</footer>
