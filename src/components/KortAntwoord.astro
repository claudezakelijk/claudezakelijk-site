---
// Kort-antwoord-blok (AEO): zelfstandige passage van 40-60 woorden direct onder
// de H1, zodat AI Overviews en LLM's het antwoord kunnen extraheren zonder de
// hele pagina te hoeven samenvatten. Rendert niets als er geen tekst is.
interface Props {
  tekst: string | null;
  stand?: Date | string | null;
}

const { tekst, stand = null } = Astro.props;

if (tekst) {
  const n = tekst.trim().split(/\s+/).length;
  if (n < 40 || n > 65) console.warn(`[KortAntwoord] ${n} woorden (doel 40-60): ${tekst.slice(0, 60)}...`);
}
const standTekst = stand instanceof Date
  ? stand.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : stand;
---
{tekst && (
  <div data-kort-antwoord class="mt-6 rounded-lg border-l-4 border-accent-diep bg-papier-dieper px-5 py-4">
    <p class="text-xs font-semibold uppercase tracking-widest text-inkt-zacht">In het kort</p>
    <p class="mt-2 text-lg leading-relaxed">{tekst}</p>
    {standTekst && <p class="mt-2 text-xs text-inkt-zacht">Stand: {standTekst}</p>}
  </div>
)}
