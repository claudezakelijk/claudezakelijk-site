---
interface Props {
  title: string;
  description: string;
  sector: string;
  duration: string;
  tools: string[];
  results: string[];
  kernwinst?: string;
  slug: string;
}
const { title, description, sector, duration, tools, results, kernwinst, slug } = Astro.props;

// Kaart leadt met de concrete winst: kernwinst indien aanwezig, anders het eerste resultaat.
const winst = kernwinst ?? results[0];
---
<article class="v2-casekaart reveal-target">
  <div class="v2-casekaart-meta">
    <span>{sector}</span>
    <span class="v2-punt" aria-hidden="true"></span>
    <span>{duration}</span>
  </div>
  <h3>{title}</h3>
  {winst && (
    <p class="v2-casekaart-winst">
      <span class="v2-vink" aria-hidden="true">&#10003;</span>
      <span>{winst}</span>
    </p>
  )}
  <p class="v2-casekaart-tekst">{description}</p>
  <div class="v2-casekaart-tools">
    {tools.slice(0, 4).map((tool) => (
      <span>{tool}</span>
    ))}
  </div>
  <a href={`/cases/${slug}`}>Lees deze case <span class="cta-arrow">&rarr;</span></a>
</article>
