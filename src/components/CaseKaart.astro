---
interface Props {
  title: string;
  description: string;
  sector: string;
  duration: string;
  tools: string[];
  results: string[];
  kernwinst?: string;
  slug: string;
}
const { title, description, sector, duration, tools, results, kernwinst, slug } = Astro.props;

// Kaart leadt met de concrete winst: kernwinst indien aanwezig, anders het eerste resultaat.
const winst = kernwinst ?? results[0];
---
<article class="flex flex-col gap-3 rounded-[20px] border border-lijn bg-white p-6 reveal-target">
  <div class="flex items-center gap-2.5 text-[12px] font-semibold uppercase tracking-[0.08em] text-accent-diep">
    <span>{sector}</span>
    <span class="w-[3px] h-[3px] rounded-full bg-ink-muted" aria-hidden="true"></span>
    <span>{duration}</span>
  </div>
  <h3 class="font-newsreader font-medium text-[22px] leading-[1.2] tracking-[-0.01em] text-ink-diep">{title}</h3>
  {winst && (
    <p class="flex items-start gap-2 text-[14px] font-semibold leading-snug text-ink-diep">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" class="flex-none mt-px" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#C25E3C"/><path d="M6 10.2l2.6 2.6L14 7.4" stroke="#FAF7F2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{winst}</span>
    </p>
  )}
  <p class="text-[14px] leading-[1.6] text-ink-2">{description}</p>
  <div class="flex flex-wrap gap-1.5 mt-1">
    {tools.slice(0, 4).map((tool) => (
      <span class="text-[12px] rounded-full border border-lijn bg-papier px-2.5 py-0.5 text-ink-2">{tool}</span>
    ))}
  </div>
  <a href={`/cases/${slug}`} class="mt-auto pt-1 link-terra text-[14px] font-semibold no-underline">Lees deze case <span class="cta-arrow">&rarr;</span></a>
</article>
