---
import { claudePrijzen } from '../data/claude-prijzen';

const plans = claudePrijzen.plannen;
---
<figure class="my-8">
<div class="grid gap-3 sm:grid-cols-2">
  {plans.map(plan => (
    <div class="v2-plan">
      <p class="v2-plan-naam">{plan.naam}</p>
      <p class="v2-plan-prijs">{plan.prijs}</p>
      <ul class="mt-4 space-y-2 text-sm text-inkt-zacht">
        {plan.features.map(f => (
          <li class="flex items-start gap-2">
            <span class="text-teal flex-shrink-0 mt-0.5 font-bold">&#10003;</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
<figcaption class="text-xs text-inkt-zacht mt-2">Claude-abonnementen per {claudePrijzen.peildatumTekst}. Prijzen in USD, exclusief btw. Daarnaast bestaan Claude Max 5x ({claudePrijzen.max.vijfx}) en Max 20x ({claudePrijzen.max.twintigx}) voor intensieve individuele gebruikers, met {claudePrijzen.max.apiCredits}. Bron: claude.com/pricing.</figcaption>
</figure>
