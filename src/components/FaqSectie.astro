---
interface Props {
  items: Array<{ question: string; answer: string }>;
  titel?: string;
}
const { items, titel = 'Veelgestelde vragen' } = Astro.props;
---
{items.length > 0 && (
  <section id="veelgestelde-vragen" class="v2-faq">
    <h2 class="text-[length:var(--text-h2)]">{titel}</h2>
    <div class="v2-faq-lijst">
      {items.map(item => (
        <details class="v2-faq-item">
          <summary>
            <h3>{item.question}</h3>
            <span class="v2-faq-plus" aria-hidden="true">+</span>
          </summary>
          <div class="v2-faq-antwoord"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </section>
)}
