---
interface Props {
  items: Array<{ question: string; answer: string }>;
  titel?: string;
}
const { items, titel = 'Veelgestelde vragen' } = Astro.props;
---
{items.length > 0 && (
  <section id="veelgestelde-vragen" class="mt-12">
    <h2 class="text-[length:var(--text-h2)]">{titel}</h2>
    <div class="mt-6 divide-y divide-lijn">
      {items.map(item => (
        <details class="group py-4">
          <summary class="flex cursor-pointer items-center justify-between font-serif font-bold text-lg [&::-webkit-details-marker]:hidden list-none">
            <h3 class="m-0 font-serif font-bold text-lg">{item.question}</h3>
            <span class="ml-4 text-inkt-zacht transition-transform group-open:rotate-45 flex-shrink-0">+</span>
          </summary>
          <div class="mt-3 text-inkt-zacht pr-12"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </section>
)}
