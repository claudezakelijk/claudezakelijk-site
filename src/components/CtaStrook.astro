---
interface Props {
  primaryText?: string;
  primaryLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
  // Contextuele link naar de bijpassende dienstpagina, onderaan de strook.
  // Alleen de artikel-layouts (prijs, compliance, vergelijkingen, verticalen) zetten dit.
  dienst?: 'implementatie' | 'consultant';
}
const {
  primaryText = 'Vraag een intro-call aan',
  primaryLink = '/contact',
  secondaryText = 'Doe de gratis AI-check',
  secondaryLink = '/ai-enablement-scan',
  dienst,
} = Astro.props;
---
<section class="v2-band">
  <div class="v2-band-binnen">
    <p class="v2-band-kop">Wil je weten hoe dit voor jouw organisatie werkt?</p>
    <div class="mt-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <a
        href={primaryLink}
        class="v2-knop v2-knop-wit"
      >
        {primaryText} <span aria-hidden="true">&rarr;</span>
      </a>
      {/* volle text-papier: papier/90 op teal zat met 4,47:1 nét onder AA */}
      <a href={secondaryLink} class="v2-band-link">
        {secondaryText}
      </a>
    </div>
    {dienst === 'implementatie' && (
      <p class="v2-band-noot">
        Eerst lezen hoe een traject loopt en wat het kost? Bekijk de pagina over <a href="/claude-implementatie" class="v2-band-link">Claude-implementatie</a>.
      </p>
    )}
    {dienst === 'consultant' && (
      <p class="v2-band-noot">
        Eerst weten wie het werk doet en wat het kost? Lees wat onze <a href="/claude-consultant" class="v2-band-link">Claude-consultant</a> doet.
      </p>
    )}
  </div>
</section>
