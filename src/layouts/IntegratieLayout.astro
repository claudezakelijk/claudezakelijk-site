---
import BasisLayout from './BasisLayout.astro';
import { seoVoorEntry } from '../lib/schema';
import KortAntwoord from '../components/KortAntwoord.astro';
import ArtikelBeeld from '../components/ArtikelBeeld.astro';
import ArtikelMeta from '../components/ArtikelMeta.astro';
import AdviesDisclaimer from '../components/AdviesDisclaimer.astro';
import Broodkruimel from '../components/Broodkruimel.astro';
import AuthorBio from '../components/AuthorBio.astro';
import FaqSectie from '../components/FaqSectie.astro';
import BronnenBlok from '../components/BronnenBlok.astro';
import CtaStrook from '../components/CtaStrook.astro';
import GerelateerdeLinks from '../components/GerelateerdeLinks.astro';
import ArtikelInhoud from '../components/ArtikelInhoud.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: {
    data: {
      title: string;
      titleTag: string;
      metaDescription: string;
      h1: string;
      schemaTypes: string[];
      author: 'camiel';
      internalLinks: string[];
      publishDate: Date | null;
      updatedDate: Date | null;
      reviewedBy: string | null;
      reviewedDate: Date | null;
      disclaimer: 'juridisch' | 'fiscaal' | 'juridisch-fiscaal' | null;
      changelogLine: string | null;
      kortAntwoord: string | null;
      bronnen: Array<{ titel: string; url: string | null; geraadpleegd: string | null }>;
      faq: Array<{ question: string; answer: string }>;
      softwareName: string;
      softwareUrl: string;
    };
    id: string;
  };
  pagePath: string;
  /** Koppen uit render(entry), voor de inhoudsopgave. */
  koppen?: MarkdownHeading[];
}

const { entry, pagePath, koppen = [] } = Astro.props;
const { data } = entry;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Integraties', url: '/integraties' },
  { name: data.title, url: pagePath },
];
const seo = seoVoorEntry({ pad: pagePath, sectie: 'Integraties', breadcrumbs, data });
---
<BasisLayout titel={data.titleTag} beschrijving={data.metaDescription} pad={pagePath} schema={seo.schema} artikel={seo.artikel}>
  <article class="v2-artikel">
    <div class="v2-voortgang" aria-hidden="true"></div>
    <header class="v2-artikel-kop">
      <div class="v2-artikel-kop-binnen">
        <Broodkruimel items={breadcrumbs} />
        <div class="v2-chips">
          <span class="v2-chip">
            Integratie
          </span>
          <a href={data.softwareUrl} target="_blank" rel="noopener" class="v2-chip-link">
            {data.softwareName}
          </a>
        </div>
        <h1 class="v2-artikel-h1">{data.h1}</h1>
        <ArtikelMeta publishDate={data.publishDate} updatedDate={data.updatedDate} author={data.author} reviewedBy={data.reviewedBy} reviewedDate={data.reviewedDate} disclaimer={data.disclaimer} />
      </div>
    </header>

    <div class="v2-artikel-raster">
      <ArtikelInhoud soort="zijkant" koppen={koppen} faq={data.faq.length > 0} />
      <div class="v2-artikel-tekst">
        {data.disclaimer && <AdviesDisclaimer soort={data.disclaimer} />}

        <ArtikelBeeld collectie="integraties" id={entry.id} />

        <KortAntwoord tekst={data.kortAntwoord} stand={data.updatedDate ?? data.publishDate} />

        <ArtikelInhoud soort="mobiel" koppen={koppen} faq={data.faq.length > 0} />

        <div class="prose prose-lg max-w-none v2-prose">
          <slot />
        </div>

        <BronnenBlok bronnen={data.bronnen} />

        {data.faq.length > 0 && <FaqSectie items={data.faq} />}

        <AuthorBio author={data.author} />
      </div>
    </div>
  </article>

  <div class="v2-artikel-na">
    <CtaStrook />
    <GerelateerdeLinks links={data.internalLinks} />
  </div>
</BasisLayout>
